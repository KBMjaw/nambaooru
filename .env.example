# PostgreSQL connection (Supabase pooler, transaction mode recommended on Vercel)
DATABASE_URL=postgres://user:password@host:6543/postgres
# "require" (default) or "disable" for local development
DATABASE_SSL=require

# 32+ random bytes, base64. Signs session JWTs.
AUTH_SECRET=
# 32 random bytes, base64. AES-256-GCM key for citizen PII (DOB, address).
APP_ENCRYPTION_KEY=
# Protects the /api/cron/sla endpoint (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Optional: enables LLM-assisted understanding on top of the built-in Tamil/Tanglish NLP engine
ANTHROPIC_API_KEY=
